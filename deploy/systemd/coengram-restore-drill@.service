[Unit]
Description=Quarterly isolated restore drill for Tenant %i
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=memory-operator
Group=memory-operator
SupplementaryGroups=docker
WorkingDirectory=/opt/coengram
EnvironmentFile=/etc/coengram/operator.env
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/coengram
ExecStart=/usr/local/bin/coengramctl backup restore-latest-drill --tenant-id %i --target-id restore-drill-%i-quarterly --operator-id systemd-quarterly --confirm-target restore-drill-%i-quarterly
