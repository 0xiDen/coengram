# A stable opaque identifier, not a display name or user-selected value.
TENANT_ID=01jexample00000000000000000

# Generated by coengramctl from TENANT_ID; never use the raw identifier as a log label.
# Derive this with coengramctl's shared MEMORY_TELEMETRY_HMAC_KEY_FILE configuration.
TENANT_TELEMETRY_REF=o_0000000000000000

# This directory must contain a protected file named neo4j_password. The same
# per-Tenant file is made available to the trusted gateway and worker by the
# shared deployment's TENANT_SECRETS_DIR mount. The directory also contains the
# Tenant Operations Store role's postgres_password for those trusted services.
TENANT_SECRETS_DIR=./secrets/tenants/01jexample00000000000000000

# Version and immutable multi-architecture digest must be updated together.
NEO4J_VERSION=5.26.28-community
NEO4J_DIGEST=sha256:362542416de6c09a971484d1893878016cc3b5cdec166e54b1c824a220ecd6b9
