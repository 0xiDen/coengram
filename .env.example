# Optional, non-secret local Compose overrides. `make up` supplies the current
# host group ID automatically and `make setup` creates ignored password files.

MEMORY_GATEWAY_PORT=8080
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
GRAFANA_PORT=3000

# Immutable CPU embedding model baked into the CoEngram image.
MEMORY_EMBEDDING_MODEL=/opt/coengram/models/bge-small-en-v1.5
MEMORY_EMBEDDING_DIMENSIONS=384

# Stable opaque telemetry label for the seeded development Tenant.
TENANT_TELEMETRY_REF=o_055c2de7e66d50cb
